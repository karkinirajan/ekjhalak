# ── एक झलक — Environment Variables ───────────────────────────────────────────
#
# Copy this file to .env.local for local development.
# In production, set these in Vercel (Project Settings → Environment Variables)
# or in /srv/ekjhalak/.env on a VPS.
#
# Everything listed here is read by code that exists in this repo. If you add a
# variable, add it here; if you delete the code, delete the entry.

# ── Site URL ──────────────────────────────────────────────────────────────────
# Used in metadata, sitemap, robots.txt and OG tags. Falls back to the
# production apex hostname when unset, so local builds work without it.
#   lib/site-url.ts · app/layout.tsx · app/sitemap.ts · app/robots.ts
# The apex, not www — www.ekjhalak.news 308s here.
NEXT_PUBLIC_SITE_URL=https://ekjhalak.news

# ── Database (Archive + Subscribers) ──────────────────────────────────────────
# PostgreSQL connection string used by lib/db.ts for the permanent article
# archive (lib/article-store.ts) and subscriber persistence (lib/subscribers.ts).
# Entirely optional for local development: when unset, /api/news builds from RSS
# and skips database writes.
#   lib/db.ts · lib/article-store.ts · lib/subscribers.ts
# DATABASE_URL=postgresql://user:password@host:5432/ekjhalak

# ── Cache Revalidation & Cron ─────────────────────────────────────────────────
# POST /api/revalidate?secret=… and GET /api/archive?secret=…
# REQUIRED in production — both routes fail closed (401) when unset in
# production rather than exposing an unauthenticated endpoint.
# Generate with: openssl rand -hex 32
#   app/api/revalidate/route.ts · app/api/archive/route.ts
# REVALIDATE_SECRET=your-long-random-secret-here

# GET /api/revalidate with `Authorization: Bearer $CRON_SECRET`
# Used by Vercel Cron or the Cloudflare Worker scheduled trigger.
# Generate with: openssl rand -hex 32
#   app/api/revalidate/route.ts · cloudflare/worker.mjs
# CRON_SECRET=your-different-long-random-secret-here

# ── Newsletter (Double Opt-In) ────────────────────────────────────────────────
# Signs and verifies the HMAC confirmation links emailed to subscribers.
# Must be at least 16 characters.
# Generate with: openssl rand -hex 32
#   lib/subscribe-token.ts · app/api/subscribe/route.ts
# NEWSLETTER_SECRET=your-third-long-random-secret-here

# Provider A: Resend (https://resend.com)
#   lib/newsletter.ts
# RESEND_API_KEY=re_...
# RESEND_AUDIENCE_ID=
# NEWSLETTER_FROM=EkJhalak <support@ekjhalak.news>
# NEWSLETTER_REPLY_TO=support@ekjhalak.news

# Provider B: Generic webhook fallback (optional)
# NEWSLETTER_WEBHOOK_URL=https://api.example.com/subscribers
# NEWSLETTER_API_KEY=

# ── AI Enrichment: Provider 1 — Groq (Primary) ───────────────────────────────
# Rewrites over-long RSS bodies into a brief in the article's own language, and
# translates headline and brief into the other language (EN ↔ NP).
# Unset is fine: summaries fall back to publisher text truncation.
# Free tier key at https://console.groq.com/keys
#   lib/summarizer.ts · lib/token-ledger.ts
# GROQ_API_KEY=your-groq-api-key-here
# Optional separate keys to split summary and translation quotas:
# EKJHALAK_SUMMARY=
# EKJHALAK_TRANSLATION=

# Optional model overrides and token-ledger tuning:
# GROQ_MODEL_SUMMARY=openai/gpt-oss-120b
# GROQ_MODEL_TRANSLATE=qwen/qwen3-32b
# GROQ_BATCH_SIZE=3
# GROQ_CONCURRENCY=3
# GROQ_BUDGET_MS=25000
# GROQ_DAILY_TOKEN_BUDGET=200000
# GROQ_MAX_BATCHES_PER_PASS=3

# ── AI Enrichment: Provider 2 — OpenRouter (Fallback) ────────────────────────
# Metered by request rather than token.
#   lib/summarizer.ts · lib/request-ledger.ts
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL_SUMMARY=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_MODEL_TRANSLATE=google/gemma-4-31b-it:free
# OPENROUTER_DAILY_REQUEST_BUDGET=50
# OPENROUTER_MINUTE_REQUEST_LIMIT=20
# OPENROUTER_SITE_URL=https://ekjhalak.news
# OPENROUTER_APP_TITLE=EkJhalak

# ── AI Enrichment: Provider 3 — Gemini (Fallback) ────────────────────────────
#   lib/summarizer.ts
# GEMINI_API_KEY=
# GEMINI_MODEL_SUMMARY=gemini-2.5-flash
# GEMINI_MODEL_TRANSLATE=gemini-2.5-flash

# ── Pipeline Budgets & Publish Policy ─────────────────────────────────────────
# AGGREGATE_BUDGET_MS=45000
# EXTRACT_BUDGET_MS=15000
# VERIFY_BUDGET_MS=8000
# PUBLISH_POLICY=audited
