{
  "name": "clutterfreenews",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next/dev/cache/turbopack",
    "dev:fresh": "rm -rf .next/dev/cache/turbopack .next/cache && next dev",
    "clean:next": "rm -rf .next",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "check:contrast": "node scripts/check-contrast.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run check:contrast && pnpm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.5.9",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^20.19.37",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.1",
    "shadcn": "^4.1.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3"
  }
}
