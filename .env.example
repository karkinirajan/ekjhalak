# EkJhalak environment — copy to .env and replace every demo value.
# A blank value is treated as "not set" (lib/env.ts), so unused entries can stay empty.
# Production values live in the host's environment settings, never in git.

# --- Required ---------------------------------------------------------------
# Apex domain: no www, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://ekjhalak.news
# Postgres connection string. Non-local hosts are connected over verified TLS.
DATABASE_URL=postgresql://demo_user:demo_password@localhost:5432/ekjhalak
# Long random strings — generate each with: openssl rand -hex 32 (all three must differ).
REVALIDATE_SECRET=demo-replace-with-openssl-rand-hex-32-a
CRON_SECRET=demo-replace-with-openssl-rand-hex-32-b
NEWSLETTER_SECRET=demo-replace-with-openssl-rand-hex-32-c

# --- Newsletter (Resend) ----------------------------------------------------
# https://resend.com/api-keys — spelled RESEND, not RESENT.
RESEND_API_KEY=re_demo_xxxxxxxxxxxxxxxxxxxx
# https://resend.com/audiences (optional)
RESEND_AUDIENCE_ID=
NEWSLETTER_FROM=EkJhalak <support@ekjhalak.news>
NEWSLETTER_REPLY_TO=support@ekjhalak.news

# --- AI summaries (optional; the pipeline falls back to extraction without them)
# https://console.groq.com/keys
GROQ_API_KEY=gsk_demo_xxxxxxxxxxxxxxxxxxxx
GROQ_DAILY_TOKEN_BUDGET=200000
GROQ_MAX_BATCHES_PER_PASS=3
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-demo-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL_SUMMARY=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL_TRANSLATE=google/gemma-4-31b-it:free
OPENROUTER_DAILY_REQUEST_BUDGET=50
OPENROUTER_MINUTE_REQUEST_LIMIT=20
# https://aistudio.google.com/apikey
GEMINI_API_KEY=demo-gemini-api-key
# The code default of 15000 starves the archive write; production-setup.md says use 45000.
AGGREGATE_BUDGET_MS=45000

# --- Optional: scripts/translate-bakeoff.mjs only ---------------------------
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
