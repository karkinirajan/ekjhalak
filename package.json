{
  "name": "clutterfreenews",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next/dev/cache/turbopack",
    "dev:fresh": "rm -rf .next/dev/cache/turbopack .next/cache && next dev",
    "clean:next": "rm -rf .next",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "node --import tsx --test lib/*.test.ts",
    "check:contrast": "node scripts/check-contrast.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run check:contrast && pnpm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.3"
  }
}
